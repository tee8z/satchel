# Satchel example for Mutinynet (signet). TEST NETWORKS ONLY:
# the server refuses to start if LND reports Bitcoin mainnet.

[server]
# Private listener; put an HTTPS reverse proxy (see Caddyfile.example) in front.
bind_address = "127.0.0.1:8095"
# Public origin. Lightning Addresses are <username>@<this host>.
public_url = "https://wallet.example.org"
database_path = "/var/lib/satchel/wallet.db"
# Optional private listener for /metrics and /healthz (Prometheus).
metrics_address = "127.0.0.1:9095"
# The reverse proxy sets this header; the right-most address is the client.
client_ip_header = "x-forwarded-for"
# argon2id hash from `satchel hash-password`, relative to CREDENTIALS_DIRECTORY
# or this file. SATCHEL_ADMIN_PASSWORD_HASH overrides it. Omit to disable /admin.
admin_password_hash_file = "admin-password.hash"
# Optional separate origin for the operator pages (for example a VPN-only name).
# When set, /admin answers only on this host.
# operator_url = "https://wallet-admin.example.org:9443"
reserved_usernames = []
session_days = 14
# Apps that send users here with "Open Satchel" (handoff sign-in) and look up
# their Lightning Address from the browser; see docs/integrating.md. HTTPS
# origins only. Handoffs from these skip the confirmation page; handoffs from
# anywhere else still work after one more click.
# handoff_origins = ["https://app.example.org"]
handoff_origins = []

[lnd]
# LND REST endpoint, certificate, and a macaroon baked with:
#   lncli bakemacaroon info:read invoices:read invoices:write offchain:read offchain:write onchain:read
rest_host = "127.0.0.1:8080"
tls_cert_path = "tls.cert"
macaroon_path = "wallet.macaroon"
request_timeout_secs = 10
payment_timeout_secs = 60
# Refuse to start unless LND is on exactly this network.
expected_network = "signet"

[limits]
max_balance_sat = 1_000_000
max_payment_sat = 250_000
min_receive_sat = 1
max_receive_sat = 250_000
invoice_expiry_secs = 3600
# Routing fee budget: 1% of the amount, at least 10 sats.
fee_limit_ppm = 10_000
min_fee_limit_sat = 10
# Unpaid, unexpired invoices per account, counted separately for invoices the
# owner creates and invoices payers request through the address.
max_open_invoices = 100

[faucet]
# Off unless enabled. Grants are IOUs on the node's channel balance and are
# refused once all balances together would exceed it.
enabled = true
amount_sat = 10_000
# Rolling 24-hour caps. The per-address cap is shared by everyone behind one
# address (a conference NAT), so size it for a crowd but below the global cap.
per_account_daily_sat = 20_000
per_address_daily_sat = 250_000
global_daily_sat = 500_000

# Limits per address are sized for a few hundred people behind one NAT; limits
# per account stay tight; global caps bound the total. See docs/abuse-protection.md.
[rate_limits]
login_per_ip_per_minute = 120
login_per_account_per_hour = 30
signup_per_ip_per_hour = 300
signups_global_per_hour = 1000
lnurl_per_ip_per_minute = 600
lnurl_per_account_per_minute = 30
send_per_account_per_minute = 10
receive_per_account_per_minute = 20
# IPv6 clients count as one address per prefix of this length.
ipv6_prefix_len = 56

# Proof of work for creating accounts, solved in the browser. One more bit for
# every step_signups accounts created in the last hour, up to max_bits.
[pow]
enabled = true
base_bits = 18
max_bits = 22
step_signups = 200

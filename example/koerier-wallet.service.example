[Unit]
Description=koerier-wallet (test networks only)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=koerier-wallet
ExecStart=/usr/local/bin/koerier-wallet --config /etc/koerier-wallet/config.toml
LoadCredential=tls.cert:/srv/lnd/tls.cert
LoadCredential=wallet.macaroon:/srv/lnd/wallet.macaroon
LoadCredential=admin-password.hash:/etc/koerier-wallet/admin-password.hash
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
